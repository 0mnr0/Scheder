TG_TOKEN=
DB_HOST=postgres
DB_NAME=AcademySched
DB_USER=
DB_PASS=
POSTGRES_ROOT_PASSWORD=

### Additional keys is below (any of them can be empty) 

# string (if empty - weather will not be available), obtain key on weatherapi.com
WEATHER_TOKEN=

# long [can be empty] - Sets Debug UID (Shows Perfomace Metric in chats)
DebugUID=

# bool [true/false] (acts as false by default), if set - bot will only respond for DebugUID user (bot will read other msgs but do not respond)
ProdPrepare=

# bool [true/false] [In groups only]
# Shows Perfomance Metric to user that asked /sched (if set DebugUID - Perfomance Metric will be sent to 2 persons) 
# Works only with AllowSendingResponseSpeed=true (Behaivour.cs)
TalkativePerformance=

#bool [true/false]:
DisableCaching=       # Disables program side caching system
DisableTokenCaching=  # Last Parsed User Token is forced to be skipped 

# bool (True/False) - "True" is not recommended for production, its uses background materials loading instead of waiting for them
# ALso skips token PreFetch startup and web-render warmup 
FastStart=

# bool (True/False)
DisableEarlyDayFix=

# (see Readme to add a user with pre-fetch data)
PreFetchData='{}'

# Additional, Proxy (Supports: Socks5E, Socks5, Socks4, Socks4a, HTTP/S)
UseProxy=           # bool [true/false]
ProxyConnection=
        # socks5e://user:pass@IP:PORT
        # socks5://user:pass@IP:PORT
        # socks4://user:pass@IP:PORT
        # http://user:pass@IP:PORT

